{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "host": "deno task -t dev --host",
    "build": "vite build",
    "start": "deno serve --unstable-kv -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@libs/qrcode": "jsr:@libs/qrcode@^3.0.0",
    "@preact-icons/md": "jsr:@preact-icons/md@^1.0.13",
    "@preact-icons/tb": "jsr:@preact-icons/tb@^1.0.14",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/http": "jsr:@std/http@^1.0.21",
    "fresh": "jsr:@fresh/core@^2.1.4",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.4.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.7",
    "vite": "npm:vite@^7.2.2",
    "tailwindcss": "npm:tailwindcss@^4.1.17",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.17"
  },
  "unstable": ["kv"],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "deploy": {
    "org": "legoguy32109",
    "app": "tutorial-with-fresh"
  }
}
